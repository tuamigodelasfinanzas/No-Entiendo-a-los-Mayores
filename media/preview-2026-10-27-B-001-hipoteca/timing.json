{
 "id": "001-hipoteca",
 "total": 33.2,
 "voice": true,
 "lines": [
  {
   "who": "r",
   "start": 0.25,
   "dur": 1.34,
   "text": "¿Qué es una hipoteca?"
  },
  {
   "who": "e",
   "start": 1.87,
   "dur": 3.91,
   "text": "Fácil. El banco te deja dinero para comprar una casa."
  },
  {
   "who": "e",
   "start": 6.07,
   "dur": 3.6,
   "text": "Y luego se lo devuelves. Durante treinta años."
  },
  {
   "who": "r",
   "start": 9.95,
   "dur": 3.72,
   "text": "¿Treinta años? ¡Si mi padre tiene cuarenta!"
  },
  {
   "who": "r",
   "start": 13.95,
   "dur": 2.06,
   "text": "¿Y devuelves lo mismo que te dejaron?"
  },
  {
   "who": "e",
   "start": 16.29,
   "dur": 4.42,
   "text": "No. Bastante más. Se llaman intereses."
  },
  {
   "who": "r",
   "start": 20.99,
   "dur": 2.35,
   "text": "O sea, que pagas una casa y media."
  },
  {
   "who": "e",
   "start": 23.62,
   "dur": 1.66,
   "text": "Pero al final la casa es tuya."
  },
  {
   "who": "r",
   "start": 25.55,
   "dur": 1.94,
   "text": "¿Y mientras tanto, de quién es?"
  },
  {
   "who": "e",
   "start": 27.78,
   "dur": 1.3,
   "text": "Un poquito del banco."
  },
  {
   "who": "ambos",
   "start": 30.55,
   "dur": 1.32,
   "text": "Cosas de mayores."
  }
 ]
}